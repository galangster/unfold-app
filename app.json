{
  "expo": {
    "name": "Unfold",
    "slug": "unfold-app",
    "version": "1.1.14",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#0A0A0A",

    "scheme": "unfold",
    "userInterfaceStyle": "automatic",
    "ios": {
      "backgroundColor": "#0A0A0A",
      "supportsTablet": true,
      "bundleIdentifier": "com.unfoldapp.ios",
      "buildNumber": "297",
      "deploymentTarget": "16.4",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Unfold to use speech recognition to convert your voice to text.",
        "NSMicrophoneUsageDescription": "Allow Unfold to use the microphone for voice input.",
        "NSPhotoLibraryAddUsageDescription": "Allow Unfold to save devotional quotes and wallpapers to your photo library.",
        "NSPhotoLibraryUsageDescription": "Allow Unfold to access your photos for sharing devotional content.",
        "UIBackgroundModes": [
          "audio",
          "remote-notification",
          "fetch"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.unfoldapp.ios",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-system-ui",
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true,
            "flipper": false
          },
          "android": {
            "newArchEnabled": true
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Unfold to use Face ID for secure authentication."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Unfold to use the microphone for voice input.",
          "speechRecognitionPermission": "Allow Unfold to use speech recognition to convert your voice to text."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0A0A0A",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-task-manager",
      "expo-background-fetch",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.unfoldapp.ios.widgets",
          "groupIdentifier": "group.com.unfoldapp.ios",
          "enablePushNotifications": false,
          "widgets": [
            {
              "name": "UnfoldStreak",
              "displayName": "Streak",
              "description": "Your daily reading streak at a glance",
              "supportedFamilies": [
                "systemSmall",
                "accessoryCircular"
              ]
            },
            {
              "name": "UnfoldToday",
              "displayName": "Today's Reading",
              "description": "Today's devotional with scripture preview",
              "supportedFamilies": [
                "systemMedium"
              ]
            },
            {
              "name": "UnfoldDashboard",
              "displayName": "Devotional",
              "description": "Your devotional journey at a glance",
              "supportedFamilies": [
                "systemLarge"
              ]
            }
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/PPEditorialNew-Light.otf",
              "./assets/fonts/Inter_400Regular.ttf",
              "./assets/fonts/Inter_400Regular_Italic.ttf",
              "./assets/fonts/Inter_500Medium.ttf",
              "./assets/fonts/Inter_600SemiBold.ttf",
              "./assets/fonts/Inter_700Bold.ttf",
              "./assets/fonts/SourceSerifPro_400Regular.ttf",
              "./assets/fonts/SourceSerifPro_400Regular_Italic.ttf",
              "./assets/fonts/SourceSerifPro_600SemiBold.ttf",
              "./assets/fonts/SourceSerifPro_700Bold.ttf"
            ]
          },
          "android": {
            "fonts": [
              { "fontFamily": "PPEditorialNew-Light", "fontDefinitions": [{ "path": "./assets/fonts/PPEditorialNew-Light.otf", "weight": 300 }] },
              { "fontFamily": "Inter_400Regular", "fontDefinitions": [{ "path": "./assets/fonts/Inter_400Regular.ttf", "weight": 400 }] },
              { "fontFamily": "Inter_400Regular_Italic", "fontDefinitions": [{ "path": "./assets/fonts/Inter_400Regular_Italic.ttf", "weight": 400, "style": "italic" }] },
              { "fontFamily": "Inter_500Medium", "fontDefinitions": [{ "path": "./assets/fonts/Inter_500Medium.ttf", "weight": 500 }] },
              { "fontFamily": "Inter_600SemiBold", "fontDefinitions": [{ "path": "./assets/fonts/Inter_600SemiBold.ttf", "weight": 600 }] },
              { "fontFamily": "Inter_700Bold", "fontDefinitions": [{ "path": "./assets/fonts/Inter_700Bold.ttf", "weight": 700 }] },
              { "fontFamily": "SourceSerifPro_400Regular", "fontDefinitions": [{ "path": "./assets/fonts/SourceSerifPro_400Regular.ttf", "weight": 400 }] },
              { "fontFamily": "SourceSerifPro_400Regular_Italic", "fontDefinitions": [{ "path": "./assets/fonts/SourceSerifPro_400Regular_Italic.ttf", "weight": 400, "style": "italic" }] },
              { "fontFamily": "SourceSerifPro_600SemiBold", "fontDefinitions": [{ "path": "./assets/fonts/SourceSerifPro_600SemiBold.ttf", "weight": 600 }] },
              { "fontFamily": "SourceSerifPro_700Bold", "fontDefinitions": [{ "path": "./assets/fonts/SourceSerifPro_700Bold.ttf", "weight": 700 }] }
            ]
          }
        }
      ],
      "expo-image",
      "expo-mail-composer",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A",
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-sqlite",
      "expo-status-bar",
      "expo-video",
      "expo-web-browser",
      "@config-plugins/expo-uiscene-lifecycle"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "turboModules": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7f3bd89f-5b75-421d-81d3-3097787c984b"
      }
    },
    "owner": "0xgala"
  }
}
