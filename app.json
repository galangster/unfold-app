{
  "expo": {
    "name": "Unfold",
    "slug": "unfold-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#0A0A0A",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "scheme": "unfold",
    "userInterfaceStyle": "automatic",
    "ios": {
      "backgroundColor": "#0A0A0A",
      "supportsTablet": true,
      "bundleIdentifier": "com.unfoldapp.ios",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Unfold to use speech recognition to convert your voice to text.",
        "NSMicrophoneUsageDescription": "Allow Unfold to use the microphone for voice input.",
        "NSPhotoLibraryAddUsageDescription": "Allow Unfold to save devotional quotes and wallpapers to your photo library.",
        "NSPhotoLibraryUsageDescription": "Allow Unfold to access your photos for sharing devotional content."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.unfoldapp.ios",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-system-ui",
      "expo-router",
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true,
            "flipper": false
          },
          "android": {
            "newArchEnabled": true
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Unfold to use Face ID for secure authentication."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Unfold to use the microphone for voice input.",
          "speechRecognitionPermission": "Allow Unfold to use speech recognition to convert your voice to text."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0A0A0A"
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.unfoldapp.ios.widgets",
          "enablePushNotifications": false,
          "widgets": [
            {
              "name": "UnfoldStreak",
              "displayName": "Streak",
              "description": "Your daily reading streak at a glance",
              "supportedFamilies": [
                "systemSmall",
                "accessoryCircular"
              ]
            },
            {
              "name": "UnfoldToday",
              "displayName": "Today's Reading",
              "description": "Today's devotional with scripture preview",
              "supportedFamilies": [
                "systemMedium"
              ]
            },
            {
              "name": "UnfoldDashboard",
              "displayName": "Devotional",
              "description": "Your devotional journey at a glance",
              "supportedFamilies": [
                "systemLarge"
              ]
            }
          ]
        }
      ],
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.io/",
          "project": "unfold-react-native",
          "organization": "the-creative-company"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "turboModules": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7f3bd89f-5b75-421d-81d3-3097787c984b"
      }
    },
    "owner": "0xgala"
  }
}
