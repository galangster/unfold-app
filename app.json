{
  "expo": {
    "name": "Unfold",
    "slug": "unfold",
    "scheme": "vibecode",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vibecode.unfold.x9fj08t",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Unfold accesses your photo library so you can move media between the app and your library.",
        "NSPhotoLibraryAddUsageDescription": "Unfold saves media you export from the app into your photo library.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.vibecode.unfold.x9fj08t",
      "enableProguardInReleaseBuilds": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-video",
      "expo-web-browser",
      "react-native-edge-to-edge",
      "@react-native-community/datetimepicker",
      ["expo-build-properties", {
        "ios": {
          "useModularHeaders": true
        }
      }],
      "expo-font",
      "expo-mail-composer",
      "expo-secure-store",
      "expo-sqlite",
      "expo-image",
      "expo-sharing",
      "expo-audio",
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "icon": "./icon.png",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "60fa8ea3-9fea-43b9-89e3-ada4a7dc4b02"
      }
    },
    "owner": "0xgala"
  }
}
