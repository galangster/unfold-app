# Firebase Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git

FIREBASE_API_KEY=your_api_key_here
FIREBASE_GCM_SENDER_ID=your_gcm_sender_id
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_bucket.firebasestorage.app
FIREBASE_GOOGLE_APP_ID=your_google_app_id

# Churned-user discounted winback SKU path.
# Keep unset/0 for v1 launch unless unfold_yearly_winback is fully approved and QA'd.
EXPO_PUBLIC_ENABLE_CHURNED_WINBACK_OFFER=0
