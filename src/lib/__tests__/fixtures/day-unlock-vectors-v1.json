{
  "version": 1,
  "rule": "A reading finished on a local day opens the next reading at the start of the following local day. The series calendar never opens a day earlier. Times are wall-clock times in the reader's own time zone.",
  "openThroughDay": "Let latestReadToday be the highest day number whose readAt falls on today's local date. When latestReadToday exists, currentDay is above it and the day at currentDay is unread, openThroughDay is latestReadToday. Otherwise openThroughDay is currentDay. A day that is missing counts as unread.",
  "pushTiming": "A ready push for day N goes out at the earliest instant t at or after the day finishes generating such that N is at most openThroughDay at t and t is not before the reader's preferred time on its local day. delayedBy says what delays it: pacingLock (day N is still locked at generation time), preferredTime (day N is open but the preferred time has not come) or none (send at once).",
  "cases": [
    {
      "name": "behind the series calendar: a reading finished this morning keeps the next day locked until the next local day",
      "timeZone": "Pacific/Honolulu",
      "seriesStartLocal": "2026-10-01T05:00",
      "currentDay": 4,
      "reads": [
        { "day": 1, "readAtLocal": "2026-10-02T06:10" },
        { "day": 2, "readAtLocal": "2026-10-03T06:05" },
        { "day": 3, "readAtLocal": "2026-10-04T05:30" }
      ],
      "checks": [
        { "nowLocal": "2026-10-04T05:31", "openThroughDay": 3 },
        { "nowLocal": "2026-10-04T06:00", "openThroughDay": 3 },
        { "nowLocal": "2026-10-04T23:59", "openThroughDay": 3 },
        { "nowLocal": "2026-10-05T00:00", "openThroughDay": 4 },
        { "nowLocal": "2026-10-05T06:00", "openThroughDay": 4 }
      ]
    },
    {
