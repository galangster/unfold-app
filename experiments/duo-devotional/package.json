{
  "name": "unfold-connected-devotional-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4386 --strictPort",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./jsconfig.json && tsc -p tools/tsconfig.json",
    "test": "bun run test:unit && bun run test:components && bun run test:lint",
    "lint": "NODE_OPTIONS=--experimental-strip-types oxlint",
    "test:unit": "bun test src/session.test.js",
    "test:components": "vitest run",
    "test:lint": "bun test tests/lint.test.js"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.83.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@testing-library/svelte": "^5.2.0",
    "jsdom": "^26.1.0",
    "lucide-svelte": "1.0.1",
    "oxlint": "1.83.0",
    "svelte": "^5.40.0",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
